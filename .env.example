# ============================================================
# ANZU — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to git.
# ============================================================

# --- LLM (required for the "ask" command) -------------------

# Base URL of the OpenAI-compatible API
# Examples:
#   OpenAI:       https://api.openai.com/v1
#   local Ollama: http://localhost:11434/v1
ANZU_LLM_BASE_URL=https://api.groq.com/openai/v1

# Model name as the provider expects it
# Examples: gpt-4o-mini, gpt-4o, llama3, mistral
ANZU_LLM_MODEL=openai/gpt-oss-120b

# API key (leave empty if your provider does not require one)
ANZU_LLM_API_KEY=

# --- Agent behaviour (optional) -----------------------------

# Set to true to let the agent execute write actions without asking you first.
# Default: false (agent will ask for confirmation before any change)
AUTO_CONFIRM_WRITES=false

# Maximum number of LLM→tool call rounds per "ask" request.
# Default: 5
ANZU_MAX_ITERATIONS=5
